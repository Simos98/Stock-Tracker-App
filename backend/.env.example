# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# Set to 1 for local development (enables the debugger and dev-only secrets)
FLASK_DEBUG=1

# Required when FLASK_DEBUG is not 1.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Optional. Defaults to a SQLite file in backend/instance/.
# MySQL example: mysql+pymysql://USER:PASSWORD@localhost:3306/finance_companion
DATABASE_URL=

# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Comma-separated origins allowed to call the API cross-origin
CORS_ORIGINS=http://localhost:5173
